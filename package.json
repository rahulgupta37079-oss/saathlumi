{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply togetherly-db --local",
    "test": "node tests/api.test.mjs",
    "test:db": "python3 tests/database.test.py",
    "test:browser": "node tests/browser.test.mjs",
    "test:payments": "node --test tests/payment.test.mjs",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.63.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
